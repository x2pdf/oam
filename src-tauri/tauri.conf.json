{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OAM",
  "version": "26.1.0",
  "identifier": "com.oam.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:19006",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "OAM",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "sidebarImage": "windows/nsis-sidebar.bmp"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}