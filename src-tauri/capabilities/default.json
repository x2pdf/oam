{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-export-pdf",
    "dialog:allow-save",
    "dialog:allow-message",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "fs:allow-write-file"
  ]
}
